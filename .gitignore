# This repo mirrors the deployed site at /var/www/html on 10.0.0.100.
# Edit the HTML directly; deploy = rsync (see README).

# Retired build toolchain + pre-restructure scratch, kept on disk for reference,
# recoverable from git history. Never deployed (rsync excludes it).
_build-legacy/

# Node deps for the retired image pipeline (some files are root-owned —
# `sudo mv node_modules _build-legacy/` when convenient).
node_modules/

# un-minified Tailwind output; the pages load styles.<hash>.css
styles.css

# stray backups / build dirs, in case the toolchain is ever un-retired
*.bak
*.bak.*
dist/

# os / editor
.DS_Store
*.swp
*~
